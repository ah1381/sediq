@using Sediq.Web.Api.Helpers
@model List<Example.Service.Models.DTOs.sediqResponseDto>
@{
    ViewData["Title"] = "لیست صدیق";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>لیست صدیق</h2>
        <a asp-action="Create" class="btn btn-primary">افزودن صدیق جدید</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ردیف</th>
                    <th>کد صدیق</th>
                    <th>نام صدیق</th>
                    <th>تاریخ شروع</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    int counter = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@counter</td>
                            <td>@item.sediqCode</td>
                            <td>@item.sediqName</td>
                            <td>@item.StartDate.ToPersianDate()</td>
                            <td>
                                <button class="btn btn-sm btn-info" onclick="showDetails(@item.RowId)">جزئیات</button>
                                <button class="btn btn-sm btn-warning" onclick="showEdit(@item.RowId)">ویرایش</button>
                                <button class="btn btn-sm btn-danger" onclick="showDelete(@item.RowId)">حذف</button>
                            </td>
                        </tr>
                        counter++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">صدیقی یافت نشد</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">جزئیات صدیق</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="detailsContent"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">ویرایش صدیق</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="editContent"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">حذف صدیق</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف این صدیق اطمینان دارید؟</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">حذف</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentId = 0;
        function showDetails(id) {
            $.get('@Url.Action("Details", "Sediq")/' + id, function(data) {
                $('#detailsContent').html(data);
                $('#detailsModal').modal('show');
            });
        }
        function showEdit(id) {
            $.get('@Url.Action("Edit", "Sediq")/' + id, function(data) {
                $('#editContent').html(data);
                $('#editModal').modal('show');
            });
        }
        function showDelete(id) {
            currentId = id;
            $('#deleteModal').modal('show');
        }
        $('#confirmDelete').click(function() {
            $.post('@Url.Action("Delete", "Sediq")/' + currentId, function(response) {
                if (response.success) {
                    location.reload();
                } else {
                    alert(response.message);
                }
            });
        });
        $(document).on('submit', '#editForm', function(e) {
            e.preventDefault();
            $.post($(this).attr('action'), $(this).serialize(), function(response) {
                if (response.success) {
                    location.reload();
                } else {
                    alert(response.message);
                }
            });
        });
        
        // Initialize Persian datepicker for edit modal
        $(document).on('shown.bs.modal', '#editModal', function() {
            $('.persian-date').persianDatepicker({
                format: 'YYYY/MM/DD',
                initialValue: false,
                autoClose: true,
                calendar: {
                    persian: {
                        locale: 'fa'
                    }
                }
            });
        });
    </script>
}
