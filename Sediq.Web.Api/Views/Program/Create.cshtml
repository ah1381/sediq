@model Example.Service.Models.DTOs.ProgramCreateModel
@{
    ViewData["Title"] = "افزودن برنامه جدید";
}

<div class="container mt-4">
    <h2>افزودن برنامه جدید</h2>
    <hr />

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">نام برنامه</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="From" class="form-label">تاریخ شروع</label>
            <input asp-for="From" class="form-control" type="date" />
            <span asp-validation-for="From" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="To" class="form-label">تاریخ پایان</label>
            <input asp-for="To" class="form-control" type="date" />
            <span asp-validation-for="To" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-primary">ثبت</button>
            <a asp-action="List" class="btn btn-secondary">بازگشت</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
