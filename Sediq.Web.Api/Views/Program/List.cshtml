@using Sediq.Web.Api.Helpers
@model IEnumerable<Example.Service.Models.DTOs.ProgramResponseDto>
@{
    ViewData["Title"] = "لیست برنامه‌ها";
}

<div class="card">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0"><i class="fas fa-calendar-alt"></i> لیست برنامه‌ها</h4>
        <a asp-action="Create" class="btn btn-light btn-sm"><i class="fas fa-plus"></i> ثبت جدید</a>
    </div>
    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr><th>نام برنامه</th><th>تاریخ شروع</th><th>تاریخ پایان</th><th>عملیات</th></tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.From.ToPersianDate()</td>
                            <td>@item.To.ToPersianDate()</td>
                            <td>
                                <button class="btn btn-sm btn-info" onclick="showDetails(@item.RowId)">جزئیات</button>
                                <button class="btn btn-sm btn-warning" onclick="showEdit(@item.RowId)">ویرایش</button>
                                <button class="btn btn-sm btn-danger" onclick="showDelete(@item.RowId)">حذف</button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" class="text-center">هیچ برنامه‌ای یافت نشد</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">جزئیات برنامه</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="detailsContent"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">ویرایش برنامه</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="editContent"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">حذف برنامه</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف این برنامه اطمینان دارید؟</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">حذف</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentId = 0;
        function showDetails(id) {
            $.get('@Url.Action("Details", "Program")/' + id, function(data) {
                $('#detailsContent').html(data);
                $('#detailsModal').modal('show');
            });
        }
        function showEdit(id) {
            $.get('@Url.Action("Edit", "Program")/' + id, function(data) {
                $('#editContent').html(data);
                $('#editModal').modal('show');
            });
        }
        function showDelete(id) {
            currentId = id;
            $('#deleteModal').modal('show');
        }
        $('#confirmDelete').click(function() {
            $.post('@Url.Action("Delete", "Program")/' + currentId, function(response) {
                if (response.success) {
                    location.reload();
                } else {
                    alert(response.message);
                }
            });
        });
        $(document).on('submit', '#editForm', function(e) {
            e.preventDefault();
            $.post($(this).attr('action'), $(this).serialize(), function(response) {
                if (response.success) {
                    location.reload();
                } else {
                    alert(response.message);
                }
            });
        });
    </script>
}
