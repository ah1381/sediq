@model IEnumerable<Example.Service.Models.DTOs.sediqResponseDto>
@{
    ViewData["Title"] = "لیست صدیق";
}

<div class="card">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0">
            <i class="fas fa-list"></i>
            لیست صدیق
        </h4>
        <a asp-action="Create" class="btn btn-light btn-sm">
            <i class="fas fa-plus"></i>
            ثبت جدید
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>نام</th>
                        <th>توضیحات</th>
                        <th>تاریخ ایجاد</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.sediqName</td>
                                <td>@item.Description</td>
                                <td>@item.CreatedAt?.ToString("yyyy/MM/dd")</td>
                                <td>
                                    @if (item.Status == 1)
                                    {
                                        <span class="badge bg-success">فعال</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">غیرفعال</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="editsediq(@item.RowId)" title="ویرایش">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="deletesediq(@item.RowId)" title="حذف">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">هیچ رکوردی یافت نشد</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">ویرایش صدیق</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="editModalBody">
                <!-- Content will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function editsediq(id) {
            $.get('/sediq/Edit/' + id, function(data) {
                $('#editModalBody').html(data);
                $('#editModal').modal('show');
            });
        }

        function deletesediq(id) {
            if (confirm('آیا از حذف این رکورد اطمینان دارید؟')) {
                $.post('/sediq/Delete', { id: id }, function(result) {
                    if (result.success) {
                        location.reload();
                    } else {
                        alert('خطا در حذف رکورد: ' + result.message);
                    }
                });
            }
        }

        $(document).on('submit', '#editForm', function(e) {
            e.preventDefault();
            $.post($(this).attr('action'), $(this).serialize(), function(result) {
                if (result.success) {
                    $('#editModal').modal('hide');
                    location.reload();
                } else {
                    alert('خطا در ویرایش: ' + result.message);
                }
            });
        });
    </script>
}