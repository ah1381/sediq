@using Sediq.Web.Api.Helpers
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - سیستم مدیریت صدیق</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Vazir:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/persian-datepicker@1.2.0/dist/css/persian-datepicker.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-graduation-cap"></i>
                    سیستم مدیریت صدیق
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">خانه</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                صدیق
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Sediq" asp-action="Create">ثبت صدیق</a></li>
                                <li><a class="dropdown-item" asp-controller="Sediq" asp-action="List">لیست صدیق</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                برنامهها
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Program" asp-action="Create">ایجاد برنامه</a></li>
                                <li><a class="dropdown-item" asp-controller="Program" asp-action="List">لیست برنامهها</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                دانشآموزان
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Student" asp-action="Create">ثبت دانشآموز</a></li>
                                <li><a class="dropdown-item" asp-controller="Student" asp-action="List">لیست دانشآموزان</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                مدت زمان
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="DurationDate" asp-action="Create">ثبت مدت زمان</a></li>
                                <li><a class="dropdown-item" asp-controller="DurationDate" asp-action="List">لیست مدت زمان</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                فعالیتها
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Activity" asp-action="Create">ثبت فعالیت</a></li>
                                <li><a class="dropdown-item" asp-controller="Activity" asp-action="List">لیست فعالیتها</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                نمرات
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="ScoreForm" asp-action="Create">ثبت نمره</a></li>
                                <li><a class="dropdown-item" asp-controller="ScoreForm" asp-action="List">لیست نمرات</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    
    <main class="container my-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="footer-custom mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5>سیستم مدیریت صدیق</h5>
                    <p>سیستم جامع مدیریت دانشآموزان و فعالیتهای آموزشی</p>
                </div>
                <div class="col-md-6 text-end">
                    <p>&copy; 2025 - تمامی حقوق محفوظ است</p>
                </div>
            </div>
        </div>
    </footer>  
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/persian-date@latest/dist/persian-date.min.js"></script>
    <script src="https://unpkg.com/persian-datepicker@latest/dist/js/persian-datepicker.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function initPersianDatePickers(context) {
            context = context || document;
            $(context).find('input[type="date"]').each(function () {
                var $input = $(this);
                if ($input.hasClass("persian-datepicker")) return;
                var currentValue = $input.val();
                
                console.log('Current Value:', currentValue);
                
                var today = new Date();
                console.log('Today (Gregorian):', today);
                
                var pd = new persianDate();
                var persianToday = pd.format('YYYY/MM/DD');
                console.log('Persian Date:', persianToday);
                
                if (!currentValue) {
                    currentValue = persianToday;
                }
                
                $input.attr("type", "text").addClass("persian-datepicker");
                $input.val(currentValue);
                
                $input.persianDatepicker({
                    format: "YYYY/MM/DD",
                    initialValue: false,
                    initialValueType: 'persian',
                    autoClose: true,
                    observer: true,
                    persianDigit: true,
                    viewMode: 'day',
                    calendar: { 
                        persian: { 
                            locale: "fa",
                            showHint: true,
                            leapYearMode: 'algorithmic'
                        }
                    },
                    navigator: { 
                        enabled: true,
                        text: {
                            btnNextText: ">",
                            btnPrevText: "<"
                        }
                    },
                    toolbox: { 
                        enabled: true,
                        calendarSwitch: {
                            enabled: false
                        },
                        todayButton: {
                            enabled: true,
                            text: {
                                fa: "امروز"
                            }
                        },
                        submitButton: {
                            enabled: true,
                            text: {
                                fa: "تایید"
                            }
                        }
                    }
                });
            });
        }

        $(document).on("focus", ".persian-datepicker", function () {
            $(".persian-datepicker").not(this).each(function () {
                let picker = $(this).data("pDatepicker");
                if (picker) picker.hide();
            });
        });

        $(document).on("click", function (e) {
            let isInput = $(e.target).hasClass("persian-datepicker");
            let isPopup = $(e.target).closest(".pdp-container").length > 0;
            if (!isInput && !isPopup) {
                $(".persian-datepicker").each(function () {
                    let picker = $(this).data("pDatepicker");
                    if (picker) picker.hide();
                });
            }
        });

        $(document).on("shown.bs.modal", function (e) {
            initPersianDatePickers(e.target);
        });

        $(document).ready(function () {
            initPersianDatePickers(document);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
