@model Example.Service.Models.DTOs.ActivityFormResponseDto

<div class="row">
    <div class="col-md-6 mb-3">
        <strong>تاریخ فعالیت:</strong>
        <p>@Model.ActivityDate.ToString("yyyy/MM/dd")</p>
    </div>
    <div class="col-md-6 mb-3">
        <strong>نام برنامه:</strong>
        <p>@Model.ProgramName</p>
    </div>
    <div class="col-md-6 mb-3">
        <strong>نام شرکت کننده:</strong>
        <p>@Model.StudentName</p>
    </div>
    <div class="col-md-6 mb-3">
        <strong>تاریخ ایجاد:</strong>
        <p>@Model.CreatedAt?.ToString("yyyy/MM/dd HH:mm")</p>
    </div>
    <div class="col-md-6 mb-3">
        <strong>ایجاد شده توسط:</strong>
        <p>@Model.CreatedBy</p>
    </div>
</div>
