@model Example.Service.Models.DTOs.ActivityFormCreateModel
@{
    ViewData["Title"] = "افزودن فعالیت جدید";
}

<div class="container mt-4">
    <h2>افزودن فعالیت جدید</h2>
    <hr />

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="ActivityDate" class="form-label">تاریخ فعالیت</label>
            <input asp-for="ActivityDate" class="form-control" type="date" />
            <span asp-validation-for="ActivityDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SelectedProgramId" class="form-label">برنامه</label>
            <select asp-for="SelectedProgramId" class="form-select" asp-items="ViewBag.Programs">
                <option value="">برنامه را انتخاب کنید</option>
            </select>
            <span asp-validation-for="SelectedProgramId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SelectedStudentId" class="form-label">شرکت کننده</label>
            <select asp-for="SelectedStudentId" class="form-select" asp-items="ViewBag.Students">
                <option value="">شرکت کننده را انتخاب کنید</option>
            </select>
            <span asp-validation-for="SelectedStudentId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-primary">ثبت</button>
            <a asp-action="List" class="btn btn-secondary">بازگشت</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
