@model IEnumerable<Example.Service.Models.DTOs.ActivityFormResponseDto>

@{
    ViewData["Title"] = "لیست فعالیتها";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="fas fa-tasks"></i>
            لیست فعالیتها
        </h2>
        <a asp-action="Create" class="btn btn-warning">
            <i class="fas fa-plus"></i>
            فعالیت جدید
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="card fade-in-up">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>شناسه</th>
                                <th>تاریخ فعالیت</th>
                                <th>نام برنامه</th>
                                <th>تعداد شرکت کنندگان</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.ActivityDate.ToString("yyyy/MM/dd")</td>
                                    <td>@item.SelectedProgramName</td>
                                    <td>
                                        <span class="badge bg-info">
                                            @item.StudentNames.Count() نفر
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#studentsModal_@item.Id">
                                                <i class="fas fa-eye"></i>
                                                مشاهده
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-edit"></i>
                                                ویرایش
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash"></i>
                                                حذف
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                
                                <!-- Modal for showing students -->
                                <div class="modal fade" id="studentsModal_@item.Id" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">دانشآموزان شرکت کننده</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <ul class="list-group">
                                                    @foreach (var studentName in item.StudentNames)
                                                    {
                                                        <li class="list-group-item">
                                                            <i class="fas fa-user"></i>
                                                            @studentName
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card fade-in-up">
            <div class="card-body text-center py-5">
                <i class="fas fa-tasks fa-3x text-muted mb-3"></i>
                <h4 class="text-muted">هیچ فعالیتی یافت نشد</h4>
                <p class="text-muted">برای شروع، اولین فعالیت را ثبت کنید</p>
                <a asp-action="Create" class="btn btn-warning">
                    <i class="fas fa-plus"></i>
                    ثبت فعالیت جدید
                </a>
            </div>
        </div>
    }
</div>