@using Sediq.Web.Api.Helpers
@model Example.Service.Models.DTOs.ActivityFormUpdateModel

<form id="editForm" asp-action="Edit" method="post">
    <input type="hidden" asp-for="RowId" />
    
    <div class="mb-3">
        <label asp-for="ActivityDate" class="form-label">تاریخ فعالیت</label>
        <input asp-for="ActivityDate" class="form-control" type="date" value="@Model.ActivityDate.ToPersianDate()" />
        <span asp-validation-for="ActivityDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SelectedProgramId" class="form-label">برنامه</label>
        <input asp-for="SelectedProgramId" class="form-control" type="number" />
        <span asp-validation-for="SelectedProgramId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SelectedStudentId" class="form-label">شرکت کننده</label>
        <input asp-for="SelectedStudentId" class="form-control" type="number" />
        <span asp-validation-for="SelectedStudentId" class="text-danger"></span>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
        <button type="submit" class="btn btn-primary">ذخیره تغییرات</button>
    </div>
</form>
