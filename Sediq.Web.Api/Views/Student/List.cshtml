@model IEnumerable<Example.Service.Models.DTOs.StudentResponseDto>
@{
    ViewData["Title"] = "لیست شرکت کنندگان";
}

<div class="card">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0">
            <i class="fas fa-users"></i>
            لیست شرکت کنندگان
        </h4>
        <a asp-action="Create" class="btn btn-light btn-sm">
            <i class="fas fa-plus"></i>
            ثبت جدید
        </a>
    </div>
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="row g-3">
                @foreach (var item in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm hover-card">
                            <div class="card-body text-center">
                                <div class="mb-3">
                                    @if (item.Photos != null && item.Photos.Any())
                                    {
                                        <img src="@item.Photos.First().PhotoUrl" class="rounded-circle" style="width: 100px; height: 100px; object-fit: cover;" alt="@item.FullName" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-secondary d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                                            <i class="fas fa-user fa-3x text-white"></i>
                                        </div>
                                    }
                                </div>
                                <h5 class="card-title mb-1">@item.FullName</h5>
                                <p class="text-muted small mb-2">کد: @item.StudentCode</p>
                                <div class="mb-3">
                                    <span class="badge bg-info">@(item.Gender == Example.Domain.Entities.Gender.Male ? "مرد" : "زن")</span>
                                    <span class="badge bg-secondary">@item.MembershipDate.ToPersianDate()</span>
                                </div>
                                <div class="d-flex justify-content-center gap-2">
                                    <button type="button" class="btn btn-sm btn-info" onclick="showDetails(@item.RowId)" title="جزئیات">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-primary" onclick="showEdit(@item.RowId)" title="ویرایش">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger" onclick="showDelete(@item.RowId)" title="حذف">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-users fa-3x mb-3"></i>
                <p>هیچ شرکت کننده ای یافت نشد</p>
            </div>
        }
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">جزئیات شرکت کننده</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="detailsContent">
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">ویرایش شرکت کننده</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="editContent">
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">تایید حذف</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف این شرکت کننده اطمینان دارید؟</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">حذف</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentId = 0;

        function showDetails(id) {
            $.get('@Url.Action("Details", "Student")/' + id, function(data) {
                $('#detailsContent').html(data);
                $('#detailsModal').modal('show');
            });
        }

        function showEdit(id) {
            $.get('@Url.Action("Edit", "Student")/' + id, function(data) {
                $('#editContent').html(data);
                $('#editModal').modal('show');
            });
        }

        function showDelete(id) {
            currentId = id;
            $('#deleteModal').modal('show');
        }

        $('#confirmDelete').click(function() {
            $.post('@Url.Action("Delete", "Student")/' + currentId, function(response) {
                if (response.success) {
                    location.reload();
                } else {
                    alert(response.message);
                }
            });
        });

        $(document).on('submit', '#editForm', function(e) {
            e.preventDefault();
            var formData = new FormData(this);
            $.ajax({
                url: $(this).attr('action'),
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                },
                error: function() {
                    alert('خطا در به روز رسانی');
                }
            });
        });
    </script>
}
