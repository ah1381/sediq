@model IEnumerable<Example.Service.Models.DTOs.StudentResponseDto>

@{
    ViewData["Title"] = "لیست دانشآموزان";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="fas fa-users"></i>
            لیست دانشآموزان
        </h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-user-plus"></i>
            دانشآموز جدید
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="card fade-in-up">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>کد دانشآموز</th>
                                <th>نام کامل</th>
                                <th>کد ملی</th>
                                <th>جنسیت</th>
                                <th>تاریخ عضویت</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.StudentCode</td>
                                    <td>@item.FullName</td>
                                    <td>@item.NationalCode</td>
                                    <td>@(item.Gender == Example.Domain.Entities.Gender.Male ? "مرد" : "زن")</td>
                                    <td>@item.MembershipDate.ToString("yyyy/MM/dd")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <button type="button" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-edit"></i>
                                                ویرایش
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash"></i>
                                                حذف
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card fade-in-up">
            <div class="card-body text-center py-5">
                <i class="fas fa-user-graduate fa-3x text-muted mb-3"></i>
                <h4 class="text-muted">هیچ دانشآموزی یافت نشد</h4>
                <p class="text-muted">برای شروع، اولین دانشآموز را ثبت کنید</p>
                <a asp-action="Create" class="btn btn-success">
                    <i class="fas fa-user-plus"></i>
                    ثبت دانشآموز جدید
                </a>
            </div>
        </div>
    }
</div>