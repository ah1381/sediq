@model IEnumerable<Example.Service.Models.DTOs.StudentResponseDto>
@{
    ViewData["Title"] = "لیست شرکت کنندگان";
}

<div class="card">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0">
            <i class="fas fa-users"></i>
            لیست شرکت کنندگان
        </h4>
        <a asp-action="Create" class="btn btn-light btn-sm">
            <i class="fas fa-plus"></i>
            ثبت جدید
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>کد</th>
                        <th>نام و نام خانوادگی</th>
                        <th>کد ملی</th>
                        <th>جنسیت</th>
                        <th>تاریخ عضویت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.StudentCode</td>
                                <td>@item.FullName</td>
                                <td>@item.NationalCode</td>
                                <td>@(item.Gender == Example.Domain.Entities.Gender.Male ? "مرد" : "زن")</td>
                                <td>@item.MembershipDate.ToPersianDate()</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-sm btn-outline-info" onclick="showDetails(@item.RowId)" title="جزئیات">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="editStudent(@item.RowId)" title="ویرایش">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteStudent(@item.RowId)" title="حذف">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">هیچ شرکت کننده ای یافت نشد</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">جزئیات شرکت کننده</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="detailsModalBody">
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">ویرایش شرکت کننده</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="editModalBody">
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">تایید حذف</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف این شرکت کننده اطمینان دارید؟</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">حذف</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let deleteId = 0;

        function showDetails(id) {
            $.get('/Student/Details/' + id, function(data) {
                $('#detailsModalBody').html(data);
                $('#detailsModal').modal('show');
            });
        }

        function editStudent(id) {
            $.get('/Student/Edit/' + id, function(data) {
                $('#editModalBody').html(data);
                $('#editModal').modal('show');
            });
        }

        function deleteStudent(id) {
            deleteId = id;
            $('#deleteModal').modal('show');
        }

        $('#confirmDeleteBtn').click(function() {
            $.post('/Student/Delete', { id: deleteId }, function(result) {
                if (result.success) {
                    $('#deleteModal').modal('hide');
                    location.reload();
                } else {
                    alert('خطا: ' + result.message);
                }
            });
        });

        $(document).on('submit', '#editForm', function(e) {
            e.preventDefault();
            $.post($(this).attr('action'), $(this).serialize(), function(result) {
                if (result.success) {
                    $('#editModal').modal('hide');
                    location.reload();
                } else {
                    alert('خطا: ' + result.message);
                }
            });
        });
    </script>
}
