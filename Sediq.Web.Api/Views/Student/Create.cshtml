@model Example.Service.Models.DTOs.StudentCreateDto

@{
    ViewData["Title"] = "ثبت دانشآموز جدید";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card fade-in-up">
                <div class="card-header">
                    <i class="fas fa-user-plus"></i>
                    ثبت دانشآموز جدید
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="StudentCode" class="form-label">کد دانشآموز</label>
                                    <input asp-for="StudentCode" class="form-control" placeholder="کد دانشآموز" />
                                    <span asp-validation-for="StudentCode" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="NationalCode" class="form-label">کد ملی</label>
                                    <input asp-for="NationalCode" class="form-control" placeholder="کد ملی" />
                                    <span asp-validation-for="NationalCode" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="FirstName" class="form-label">نام</label>
                                    <input asp-for="FirstName" class="form-control" placeholder="نام" />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="LastName" class="form-label">نام خانوادگی</label>
                                    <input asp-for="LastName" class="form-control" placeholder="نام خانوادگی" />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="FatherName" class="form-label">نام پدر</label>
                                    <input asp-for="FatherName" class="form-control" placeholder="نام پدر" />
                                    <span asp-validation-for="FatherName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="FatherJob" class="form-label">شغل پدر</label>
                                    <input asp-for="FatherJob" class="form-control" placeholder="شغل پدر" />
                                    <span asp-validation-for="FatherJob" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="BirthDate" class="form-label">تاریخ تولد</label>
                                    <input asp-for="BirthDate" type="date" class="form-control" />
                                    <span asp-validation-for="BirthDate" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="MembershipDate" class="form-label">تاریخ عضویت</label>
                                    <input asp-for="MembershipDate" type="date" class="form-control" />
                                    <span asp-validation-for="MembershipDate" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Gender" class="form-label">جنسیت</label>
                                    <select asp-for="Gender" class="form-select">
                                        <option value="0">مرد</option>
                                        <option value="1">زن</option>
                                    </select>
                                    <span asp-validation-for="Gender" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="FieldOfStudy" class="form-label">رشته تحصیلی</label>
                                    <input asp-for="FieldOfStudy" class="form-control" placeholder="رشته تحصیلی" />
                                    <span asp-validation-for="FieldOfStudy" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="YearStudy" class="form-label">پایه تحصیلی</label>
                                    <input asp-for="YearStudy" class="form-control" placeholder="پایه تحصیلی" />
                                    <span asp-validation-for="YearStudy" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Address" class="form-label">آدرس</label>
                            <textarea asp-for="Address" class="form-control" rows="3" placeholder="آدرس کامل"></textarea>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">توضیحات</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="توضیحات اضافی"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>
                        
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="List" class="btn btn-secondary me-md-2">
                                <i class="fas fa-list"></i>
                                لیست دانشآموزان
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i>
                                ثبت دانشآموز
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}