@model Example.Service.Models.DTOs.ScoreFormCreateModel
@{
    ViewData["Title"] = "افزودن نمره جدید";
}

<div class="card">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">
            <i class="fas fa-plus"></i>
            افزودن نمره جدید
        </h4>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="SelectedProgramId" class="form-label">برنامه</label>
                    <select asp-for="SelectedProgramId" class="form-select" asp-items="ViewBag.Programs">
                        <option value="">برنامه را انتخاب کنید</option>
                    </select>
                    <span asp-validation-for="SelectedProgramId" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="SelectedStudentId" class="form-label">شرکت کننده</label>
                    <select asp-for="SelectedStudentId" class="form-select" asp-items="ViewBag.Students">
                        <option value="">شرکت کننده را انتخاب کنید</option>
                    </select>
                    <span asp-validation-for="SelectedStudentId" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Score" class="form-label">نمره</label>
                    <input asp-for="Score" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Score" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="ActivityDurId" class="form-label">بازه زمانی</label>
                    <select asp-for="ActivityDurId" class="form-select" asp-items="ViewBag.Durations">
                        <option value="">بازه زمانی را انتخاب کنید</option>
                    </select>
                    <span asp-validation-for="ActivityDurId" class="text-danger"></span>
                </div>
                <div class="col-md-8 mb-3">
                    <label asp-for="Description" class="form-label">توضیحات</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-3">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save"></i>
                    ذخیره
                </button>
                <a asp-action="List" class="btn btn-secondary">
                    <i class="fas fa-arrow-right"></i>
                    بازگشت به لیست
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
