@model Example.Service.Models.DTOs.ScoreFormCreateModel
@{
    ViewData["Title"] = "افزودن نمره جدید";
}

<div class="container mt-4">
    <h2>افزودن نمره جدید</h2>
    <hr />

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="SelectedProgramId" class="form-label">برنامه</label>
            <input asp-for="SelectedProgramId" class="form-control" type="number" />
            <span asp-validation-for="SelectedProgramId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SelectedStudentId" class="form-label">شرکت کننده</label>
            <input asp-for="SelectedStudentId" class="form-control" type="number" />
            <span asp-validation-for="SelectedStudentId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Score" class="form-label">نمره</label>
            <input asp-for="Score" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="Score" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ActivityDurId" class="form-label">بازه زمانی</label>
            <input asp-for="ActivityDurId" class="form-control" type="number" />
            <span asp-validation-for="ActivityDurId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">توضیحات</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-primary">ثبت</button>
            <a asp-action="List" class="btn btn-secondary">بازگشت</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
