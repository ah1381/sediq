@model Example.Service.Models.DTOs.ScoreFormCreateModel
@{
    ViewData["Title"] = "ثبت نمره";
}

<div class="card">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">
            <i class="fas fa-plus-circle"></i>
            ثبت نمره جدید
        </h4>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post" id="scoreFormCreateForm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Score" class="form-label">نمره</label>
                        <input asp-for="Score" class="form-control" step="0.01" />
                        <span asp-validation-for="Score" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="SelectedStudentId" class="form-label">دانشآموز</label>
                        <select asp-for="SelectedStudentId" class="form-select" id="studentSelect">
                            <option value="">انتخاب کنید...</option>
                        </select>
                        <span asp-validation-for="SelectedStudentId" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="SelectedProgramId" class="form-label">فعالیت</label>
                        <select asp-for="SelectedProgramId" class="form-select" id="activitySelect">
                            <option value="">انتخاب کنید...</option>
                        </select>
                        <span asp-validation-for="SelectedProgramId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="ActivityDurId" class="form-label">مدت زمان</label>
                        <select asp-for="ActivityDurId" class="form-select" id="durationSelect">
                            <option value="">انتخاب کنید...</option>
                        </select>
                        <span asp-validation-for="ActivityDurId" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Description" class="form-label">توضیحات</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            
            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save"></i>
                    ذخیره
                </button>
                <a asp-action="List" class="btn btn-secondary">
                    <i class="fas fa-arrow-right"></i>
                    بازگشت به لیست
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            loadStudents();
            loadActivities();
            loadDurations();
        });

        function loadStudents() {
            $.get('/Student/GetAll', function(data) {
                var select = $('#studentSelect');
                select.empty().append('<option value="">انتخاب کنید...</option>');
                $.each(data, function(i, item) {
                    select.append('<option value="' + item.rowId + '">' + item.fullName + '</option>');
                });
            });
        }

        function loadActivities() {
            $.get('/Activity/GetAll', function(data) {
                var select = $('#activitySelect');
                select.empty().append('<option value="">انتخاب کنید...</option>');
                $.each(data, function(i, item) {
                    select.append('<option value="' + item.rowId + '">' + item.name + '</option>');
                });
            });
        }

        function loadDurations() {
            $.get('/DurationDate/GetAll', function(data) {
                var select = $('#durationSelect');
                select.empty().append('<option value="">انتخاب کنید...</option>');
                $.each(data, function(i, item) {
                    select.append('<option value="' + item.rowId + '">' + item.name + '</option>');
                });
            });
        }
    </script>
}