@model Example.Service.Models.DTOs.ScoreFormResponseDto

<div class="row">
    <div class="col-md-6 mb-3">
        <strong>نام برنامه:</strong>
        <p>@Model.ProgramName</p>
    </div>
    <div class="col-md-6 mb-3">
        <strong>نام شرکت کننده:</strong>
        <p>@Model.StudentName</p>
    </div>
    <div class="col-md-6 mb-3">
        <strong>نمره:</strong>
        <p>@Model.Score</p>
    </div>
    <div class="col-md-6 mb-3">
        <strong>بازه زمانی:</strong>
        <p>@Model.DurationName</p>
    </div>
    <div class="col-md-12 mb-3">
        <strong>توضیحات:</strong>
        <p>@Model.Description</p>
    </div>
    <div class="col-md-6 mb-3">
        <strong>تاریخ ایجاد:</strong>
        <p>@Model.CreatedAt.ToPersianDate()</p>
    </div>
    <div class="col-md-6 mb-3">
        <strong>ایجاد شده توسط:</strong>
        <p>@Model.CreatedBy</p>
    </div>
</div>
