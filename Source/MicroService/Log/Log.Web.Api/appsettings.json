{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "log-service-group",
    "Topics": [ "exampleErrorLog"]
  },

  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017/",
    "DatabaseName": "LogDb",
    "ErrorCollection": "error_logs",
    "GroupId": "example-consumer-group"
  },

  "AllowedHosts": "*"
}
