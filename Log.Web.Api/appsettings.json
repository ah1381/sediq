{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "log-service-group",
    "Topics": [ "exampleErrorLog", "paymentErrorLog", "orderErrorLog" ]
  },

  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "LogDb",
    "CollectionName": "ErrorLogs"
  },

  "AllowedHosts": "*"
}
